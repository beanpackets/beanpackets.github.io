---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Lab notes"
  path="/notes/"
  description="Short write-ups from CCNA study, Packet Tracer labs, and day-to-day IT support work by Matthew Bean."
>
  <Nav />

  <main id="main" class="shell pt-32 pb-20 sm:pt-40">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3"><span class="text-muted">$</span> ls ~/lab-notes</p>
      <h1 class="text-4xl font-semibold sm:text-5xl">Lab notes</h1>
      <p class="mt-5 text-base leading-relaxed text-muted sm:text-lg">
        Working notes from CCNA study, Packet Tracer labs, and support work. Written as I go,
        mistakes included, because those are the ones that stick.
      </p>
      <div class="mt-7 h-px w-full bg-[linear-gradient(90deg,var(--color-accent),transparent)] opacity-40"></div>
    </div>

    <ul class="mt-12 space-y-4">
      {
        notes.map((note) => (
          <li class="panel group relative p-6 sm:p-7">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <time datetime={note.data.date.toISOString()} class="font-mono text-xs text-muted">
                {fmt(note.data.date)}
              </time>
              <div class="flex flex-wrap gap-2">
                {note.data.tags.map((t) => (
                  <span class="rounded-md border border-edge bg-ground/50 px-2 py-0.5 font-mono text-[0.68rem] text-muted">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <h2 class="mt-3 text-xl font-semibold sm:text-2xl">
              <a href={`/notes/${note.id}/`} class="transition-colors group-hover:text-accent-ink">
                <span class="absolute inset-0" />
                {note.data.title}
              </a>
            </h2>

            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
              {note.data.summary}
            </p>

            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-ink">
              Read note
              <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </li>
        ))
      }
    </ul>
  </main>

  <Footer />
</BaseLayout>
