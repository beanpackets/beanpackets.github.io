---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import Icon from './Icon.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// rotate tones so the row doesn't read as one block of colour
/* One accent, deliberately. Rotating hues across cards was decoration; in this
   system colour carries meaning, so the note cards all read the same. */
const TONES = ['accent'];
---

{
  notes.length > 0 && (
    <Section
      id="notes"
      variant="split"
      tone="yellow"
      eyebrow="tail -3 lab-notes"
      title="Lab notes"
      lead="Write-ups from CCNA study and support work, mistakes included. Those are usually the useful part."
    >
      <div class="grid gap-4 md:grid-cols-3">
        {notes.map((note, i) => (
          <article
            data-tone={TONES[i % TONES.length]}
            data-reveal-target
            class="panel tone-rule group relative flex flex-col p-6"
          >
            <div class="relative z-10 flex flex-1 flex-col">
              <time datetime={note.data.date.toISOString()} class="font-mono text-xs text-muted">
                {fmt(note.data.date)}
              </time>

              <h3 class="mt-3 text-base leading-snug font-semibold">
                <a href={`/notes/${note.id}/`} class="transition-colors group-hover:text-text">
                  <span class="absolute inset-0" />
                  {note.data.title}
                </a>
              </h3>

              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{note.data.summary}</p>

              <div class="mt-5 flex flex-wrap gap-1.5">
                {note.data.tags.slice(0, 3).map((t) => (
                  <span class="chip">{t}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <a
        href="/notes/"
        class="link-underline mt-8 inline-flex items-center gap-2 text-sm font-medium text-yellow"
      >
        All lab notes
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </Section>
  )
}
