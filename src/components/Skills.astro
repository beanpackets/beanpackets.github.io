---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { SKILLS } from '../data/resume.js';
---

<Section
  id="skills"
  variant="split"
  tone="blue"
  eyebrow="Skills"
  title="What I work with"
  lead="Day-to-day tools, plus the networking track I'm studying toward the CCNA."
>
  <!-- 6-col grid: rows of 3 then 2, no empty slot -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
    {
      SKILLS.map((group, i) => (
        <article
          class={`panel tone-rule p-6 ${i < 3 ? 'lg:col-span-2' : 'lg:col-span-3'} ${i === 4 ? 'sm:col-span-2 lg:col-span-3' : ''}`}
          data-tone={group.tone}
          data-reveal-target
        >
          <div class="relative z-10">
            <div class="flex items-start justify-between gap-3">
              <span class="tone-text">
                <Icon name={group.icon} class="h-6 w-6" />
              </span>
              {group.badge && (
                <span class="chip">
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-current" />
                  {group.badge}
                </span>
              )}
            </div>

            <h3 class="mt-4 text-base font-semibold">{group.title}</h3>

            <ul class="mt-4 space-y-2">
              {group.items.map((item) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                  <span class="tone-text mt-[3px] font-mono text-[0.6rem] opacity-70">▸</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</Section>
