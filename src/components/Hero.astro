---
import { SITE } from '../data/site.js';
import Icon from './Icon.astro';

/* Editorial split. Type sits on the page grid; the accent panel bleeds off the
   right edge. Gutter alignment is handled by .hero-copy in global.css. */
---

<section
  class="hero-split relative grid min-h-[88svh] grid-rows-[1fr_auto] pt-16 md:grid-cols-[1.55fr_1fr] md:grid-rows-1"
>
  <div class="hero-copy flex items-center py-16 pr-5 md:py-24 md:pr-12">
    <div class="max-w-2xl">
      <p class="mb-7 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tracking-wider uppercase">
        <span class="flex items-center gap-2 text-green">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-green"></span>
          {SITE.availability}
        </span>
        <span class="text-muted" aria-hidden="true">/</span>
        <span class="text-muted">{SITE.location}</span>
      </p>

      <h1 class="text-[clamp(2.9rem,8.2vw,5.25rem)] leading-[0.92] font-semibold tracking-[-0.035em]">
        Matthew<br />Bean
      </h1>

      <p class="mt-7 font-display text-[clamp(1.15rem,2.6vw,1.55rem)] leading-snug">
        IT support <span class="text-muted">&amp;</span> networking
      </p>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        Help desk operations, hardware diagnostics, and the kind of methodical troubleshooting that
        closes tickets instead of forwarding them. Studying for the CCNA.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="#work"
          class="group inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-on-accent transition-colors hover:bg-accent-ink hover:text-ground"
        >
          View my work
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={SITE.resumeFile}
          class="inline-flex items-center gap-2 rounded-lg border border-edge-bright px-5 py-3 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent-ink"
        >
          <Icon name="download" class="h-4 w-4" />
          Download résumé
        </a>
      </div>

      <button
        type="button"
        data-terminal-open
        class="mt-12 hidden items-center gap-2 font-mono text-xs text-muted transition-colors hover:text-accent-ink md:inline-flex"
      >
        <span
          class="inline-flex items-center rounded border border-edge bg-surface-2 px-1.5 py-0.5 text-[0.7rem]"
          aria-hidden="true"
        >
          ~
        </span>
        press for terminal
      </button>
    </div>
  </div>

  <!-- Accent panel. Bleeds to the right edge on desktop, becomes a band on
       mobile. With JS off this stays a clean field of colour, which is a
       perfectly good fallback — no artwork needed. -->
  <div class="relative isolate min-h-[22svh] overflow-hidden bg-accent md:min-h-0">
    <canvas
      data-network-canvas
      aria-hidden="true"
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"
    ></canvas>
    <span
      class="absolute bottom-5 left-5 font-mono text-[0.7rem] tracking-[0.14em] text-on-accent uppercase opacity-75 md:bottom-8 md:left-8"
    >
      CCNA in progress
    </span>
  </div>
</section>

<script>
  /* Drifting node mesh with packets crossing the links, drawn in the paper
     colour on top of the accent panel. Low node count, DPR capped at 2, pauses
     off-screen and on hidden tabs, never runs under reduced-motion. Without JS
     the panel is a flat field of accent, which is the intended fallback. */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-network-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduced) {
    const ctx = canvas.getContext('2d', { alpha: true });

    if (ctx) {
      const LINK_DIST = 165;
      // Paper, knocked out of the accent. One colour only — the mesh is
      // texture, not information, so it does not get to spend the palette.
      const LINE = '245, 241, 236';

      let width = 0;
      let height = 0;
      let raf = 0;
      let running = false;

      type Node = { x: number; y: number; vx: number; vy: number; r: number };
      type Packet = { a: number; b: number; t: number; speed: number };

      let nodes: Node[] = [];
      let packets: Packet[] = [];

      const rand = (min: number, max: number) => min + Math.random() * (max - min);

      function build() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = canvas!.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas!.width = Math.round(width * dpr);
        canvas!.height = Math.round(height * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Scale node count with area, but keep a hard ceiling for low-end GPUs.
        const count = Math.min(46, Math.max(14, Math.round((width * height) / 22000)));
        nodes = Array.from({ length: count }, () => ({
          x: rand(0, width),
          y: rand(0, height),
          vx: rand(-0.14, 0.14),
          vy: rand(-0.14, 0.14),
          r: rand(1, 2.3),
        }));

        packets = Array.from({ length: Math.min(9, Math.round(count / 4)) }, () => spawn());
      }

      function spawn(): Packet {
        const a = Math.floor(Math.random() * nodes.length);
        let b = Math.floor(Math.random() * nodes.length);
        if (b === a) b = (b + 1) % nodes.length;
        return { a, b, t: Math.random(), speed: rand(0.0018, 0.0052) };
      }

      function frame() {
        if (!running) return;
        ctx!.clearRect(0, 0, width, height);

        // Drift, bouncing softly off the edges.
        for (const n of nodes) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < 0 || n.x > width) n.vx *= -1;
          if (n.y < 0 || n.y > height) n.vy *= -1;
        }

        // Links, faded by distance.
        ctx!.lineWidth = 1;
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const dx = nodes[i].x - nodes[j].x;
            const dy = nodes[i].y - nodes[j].y;
            const dist = Math.hypot(dx, dy);
            if (dist >= LINK_DIST) continue;
            const alpha = (1 - dist / LINK_DIST) * 0.3;
            ctx!.strokeStyle = `rgba(${LINE}, ${alpha})`;
            ctx!.beginPath();
            ctx!.moveTo(nodes[i].x, nodes[i].y);
            ctx!.lineTo(nodes[j].x, nodes[j].y);
            ctx!.stroke();
          }
        }

        // Nodes.
        for (const n of nodes) {
          ctx!.fillStyle = `rgba(${LINE}, 0.6)`;
          ctx!.beginPath();
          ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
          ctx!.fill();
        }

        // Packets in flight.
        for (let k = 0; k < packets.length; k++) {
          const p = packets[k];
          const from = nodes[p.a];
          const to = nodes[p.b];
          if (!from || !to) {
            packets[k] = spawn();
            continue;
          }

          p.t += p.speed;
          if (p.t >= 1) {
            packets[k] = spawn();
            continue;
          }

          const x = from.x + (to.x - from.x) * p.t;
          const y = from.y + (to.y - from.y) * p.t;
          // Fade in and out at the endpoints so packets never pop.
          const fade = Math.sin(p.t * Math.PI);

          ctx!.fillStyle = `rgba(${LINE}, ${0.95 * fade})`;
          ctx!.beginPath();
          ctx!.arc(x, y, 2.1, 0, Math.PI * 2);
          ctx!.fill();
        }

        raf = requestAnimationFrame(frame);
      }

      // The loop should run only when the hero is BOTH on-screen and in a
      // visible tab. Tracking these separately matters: with a single flag,
      // returning to the tab would restart the animation even if the user had
      // long since scrolled past the hero.
      let onScreen = true;
      let tabVisible = !document.hidden;

      function sync() {
        if (onScreen && tabVisible) {
          if (running) return;
          running = true;
          raf = requestAnimationFrame(frame);
        } else if (running) {
          running = false;
          cancelAnimationFrame(raf);
        }
      }

      build();
      canvas.classList.replace('opacity-0', 'opacity-100');
      sync();

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          ([entry]) => {
            onScreen = entry.isIntersecting;
            sync();
          },
          { threshold: 0 }
        ).observe(canvas);
      }

      document.addEventListener('visibilitychange', () => {
        tabVisible = !document.hidden;
        sync();
      });

      let resizeTimer: number;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(build, 180);
      });
    }
  }
</script>
