---
import { SITE } from '../data/site.js';
import Icon from './Icon.astro';

/* Full-bleed hero. The canvas sits behind everything and a gradient keeps the
   top two-thirds near-solid so the headline never fights it. Copy stays on the
   page grid via .hero-copy. */
---

<section class="hero-split relative isolate grid min-h-[92svh] grid-rows-[1fr_auto] overflow-hidden pt-16">
  <canvas
    data-hero-canvas
    aria-hidden="true"
    class="absolute inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-1000"
  ></canvas>

  <!-- Perspective grid floor. Pure CSS, so it still runs with JS off. -->
  <div class="pointer-events-none absolute inset-0 z-[1] overflow-hidden [perspective:340px]" aria-hidden="true">
    <div class="hero-floor absolute -inset-x-[60%] -bottom-[45%] h-[160%] origin-bottom [transform:rotateX(74deg)]"></div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-[2] h-[72%] bg-[linear-gradient(to_bottom,var(--color-ground)_42%,transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 z-[3] bg-[radial-gradient(ellipse_at_50%_45%,transparent_40%,rgba(3,10,5,0.82))]"
    aria-hidden="true"
  >
  </div>

  <div class="hero-copy relative z-10 flex items-center py-16 pr-5 md:py-24 md:pr-12">
    <div class="max-w-2xl">
      <p class="mb-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <span class="text-accent-ink">{SITE.availability}</span>
        <span class="text-muted" aria-hidden="true">/</span>
        <span class="text-muted">{SITE.location}</span>
      </p>

      <h1 class="neon text-[clamp(2.9rem,8.2vw,5.25rem)] leading-[0.94] font-semibold">
        Matthew<br /><span class="neon-accent">Bean</span>
      </h1>

      <p class="mt-7 font-display text-[clamp(1.15rem,2.6vw,1.55rem)] leading-snug">
        IT support <span class="text-muted">&amp;</span> networking
      </p>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        Help desk operations, hardware diagnostics, and the kind of methodical troubleshooting that
        closes tickets instead of forwarding them. Studying for the CCNA.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="#work"
          class="group inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-on-accent shadow-[0_0_26px_-4px_rgba(57,255,20,0.55)] transition-shadow hover:shadow-[0_0_40px_-4px_rgba(57,255,20,0.8)]"
        >
          View my work
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={SITE.resumeFile}
          class="inline-flex items-center gap-2 rounded-lg border border-edge-bright px-5 py-3 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent-ink"
        >
          <Icon name="download" class="h-4 w-4" />
          Download résumé
        </a>
      </div>

      <button
        type="button"
        data-terminal-open
        class="mt-12 hidden items-center gap-2 font-mono text-xs text-muted transition-colors hover:text-accent-ink md:inline-flex"
      >
        <span
          class="inline-flex items-center rounded border border-edge bg-surface-2 px-1.5 py-0.5 text-[0.7rem]"
          aria-hidden="true"
        >
          ~
        </span>
        press for terminal
      </button>
    </div>
  </div>

  <div class="relative z-10">
    <hr class="laser" />
  </div>
</section>

<style>
  .hero-floor {
    opacity: 0.18;
    background-image:
      repeating-linear-gradient(to right, rgba(57, 255, 20, 0.5) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(to bottom, rgba(57, 255, 20, 0.5) 0 1px, transparent 1px 72px);
    animation: floor-drive 9s linear infinite;
  }

  @keyframes floor-drive {
    to {
      background-position:
        0 0,
        0 72px;
    }
  }

</style>

<script>
  /* Flow field: particles read an angle off a layered-sine field and draw one
     short segment per frame. The canvas is never cleared, only washed, so the
     trails are the image. Bloom comes from 'lighter' compositing — shadowBlur
     per stroke is what kills the framerate here. */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });

    if (ctx) {
      type Particle = { x: number; y: number; px: number; py: number; life: number };

      let width = 0;
      let height = 0;
      let raf = 0;
      let running = false;
      let particles: Particle[] = [];
      let t = 0;

      const seedA = Math.random() * 100;
      const seedB = Math.random() * 100;

      const spawn = (): Particle => ({
        x: Math.random() * width,
        y: Math.random() * height,
        px: 0,
        py: 0,
        life: 20 + Math.random() * 150,
      });

      function build() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = canvas!.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas!.width = Math.round(width * dpr);
        canvas!.height = Math.round(height * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        ctx!.globalCompositeOperation = 'source-over';
        ctx!.fillStyle = '#030a05';
        ctx!.fillRect(0, 0, width, height);

        // Scale with area, hard ceiling for low-end GPUs.
        const count = Math.min(360, Math.max(60, Math.round((width * height) / 2600)));
        particles = Array.from({ length: count }, spawn);
      }

      function angleAt(x: number, y: number) {
        const a = Math.sin(x * 0.0042 + seedA + t * 0.22) + Math.cos(y * 0.0051 - seedB + t * 0.17);
        const b = Math.sin((x + y) * 0.0027 + t * 0.11) * 1.4;
        return (a + b) * 1.15;
      }

      function step() {
        t += 0.0072;

        ctx!.globalCompositeOperation = 'source-over';
        ctx!.fillStyle = 'rgba(3, 10, 5, 0.075)';
        ctx!.fillRect(0, 0, width, height);

        ctx!.globalCompositeOperation = 'lighter';
        ctx!.lineWidth = 1.1;

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.px = p.x;
          p.py = p.y;

          const a = angleAt(p.x, p.y);
          p.x += Math.cos(a) * 0.86;
          p.y += Math.sin(a) * 0.86;
          p.life -= 0.45;

          // Hue rides the field angle: accent green through to the mint status hue.
          const hue = 104 + ((((a % 1) + 1) % 1) * 58);
          ctx!.strokeStyle = `hsla(${hue}, 100%, 58%, 0.5)`;
          ctx!.beginPath();
          ctx!.moveTo(p.px, p.py);
          ctx!.lineTo(p.x, p.y);
          ctx!.stroke();

          if (p.life < 0 || p.x < -20 || p.x > width + 20 || p.y < -20 || p.y > height + 20) {
            particles[i] = spawn();
          }
        }
      }

      function frame() {
        if (!running) return;
        step();
        raf = requestAnimationFrame(frame);
      }

      build();
      canvas.classList.replace('opacity-0', 'opacity-40');

      if (reduced) {
        // Settle on a still composition rather than showing an empty canvas.
        for (let i = 0; i < 320; i++) step();
      } else {
        // Run only when the hero is BOTH on-screen and in a visible tab. Tracked
        // separately: with one flag, returning to the tab would restart the loop
        // even if the user had long since scrolled past.
        let onScreen = true;
        let tabVisible = !document.hidden;

        const sync = () => {
          if (onScreen && tabVisible) {
            if (running) return;
            running = true;
            raf = requestAnimationFrame(frame);
          } else if (running) {
            running = false;
            cancelAnimationFrame(raf);
          }
        };

        sync();

        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            ([entry]) => {
              onScreen = entry.isIntersecting;
              sync();
            },
            { threshold: 0 }
          ).observe(canvas);
        }

        document.addEventListener('visibilitychange', () => {
          tabVisible = !document.hidden;
          sync();
        });

        let resizeTimer: number;
        window.addEventListener('resize', () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(build, 180);
        });
      }
    }
  }
</script>
