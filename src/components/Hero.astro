---
import { SITE } from '../data/site.js';
import Icon from './Icon.astro';

/* The generative canvas IS the hero. Copy sits centred on top of it, over a
   radial scrim that keeps the type readable whatever the canvas is doing.
   Mode controls sit at the foot of the section. */
---

<section class="hero relative isolate flex min-h-svh flex-col overflow-hidden pt-16">
  <canvas
    data-hero-canvas
    aria-hidden="true"
    class="absolute inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-1000"
  ></canvas>

  <!-- Perspective floor. Pure CSS, so it still reads with JS off. -->
  <div class="pointer-events-none absolute inset-0 z-[1] overflow-hidden [perspective:340px]" aria-hidden="true">
    <div class="hero-floor absolute -inset-x-[60%] -bottom-[45%] h-[160%] origin-bottom [transform:rotateX(74deg)]"></div>
  </div>

  <div class="hero-scrim pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
  <div class="hero-scan pointer-events-none absolute inset-0 z-[3]" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-1 items-center justify-center">
    <div class="shell flex flex-col items-center py-16 text-center md:py-20">
      <p class="mb-7 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm">
        <span class="text-accent-ink">{SITE.availability}</span>
        <span class="text-muted" aria-hidden="true">/</span>
        <span class="text-muted">{SITE.location}</span>
      </p>

      <h1 class="neon text-[clamp(2.9rem,8.2vw,5.25rem)] leading-[0.94] font-semibold">
        Matthew<br /><span class="neon-accent">Bean</span>
      </h1>

      <p class="mt-7 font-display text-[clamp(1.15rem,2.6vw,1.55rem)] leading-snug">
        IT support <span class="text-muted">&amp;</span> networking
      </p>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        Help desk operations, hardware diagnostics, and the kind of methodical troubleshooting that
        closes tickets instead of forwarding them. Studying for the CCNA.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#work"
          class="group inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-on-accent shadow-[0_0_26px_-4px_rgba(57,255,20,0.55)] transition-shadow hover:shadow-[0_0_40px_-4px_rgba(57,255,20,0.8)]"
        >
          View my work
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={SITE.resumeFile}
          class="inline-flex items-center gap-2 rounded-lg border border-edge-bright px-5 py-3 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent-ink"
        >
          <Icon name="download" class="h-4 w-4" />
          Download résumé
        </a>
      </div>

      <button
        type="button"
        data-terminal-open
        class="mt-12 hidden items-center gap-2 font-mono text-xs text-muted transition-colors hover:text-accent-ink md:inline-flex"
      >
        <span
          class="inline-flex items-center rounded border border-edge bg-surface-2 px-1.5 py-0.5 text-[0.7rem]"
          aria-hidden="true"
        >
          ~
        </span>
        press for terminal
      </button>
    </div>
  </div>

  <div class="relative z-10">
    <div class="shell flex flex-wrap items-center justify-center gap-x-4 gap-y-2 pb-6">
      <div class="flex flex-wrap justify-center gap-1.5" role="group" aria-label="Background mode">
        <button type="button" class="hero-btn" data-hero-mode="0" aria-pressed="true">Flow</button>
        <button type="button" class="hero-btn" data-hero-mode="1" aria-pressed="false">Warp</button>
        <button type="button" class="hero-btn" data-hero-mode="2" aria-pressed="false">Scope</button>
        <button type="button" class="hero-btn" data-hero-mode="3" aria-pressed="false">Spectrum</button>
      </div>
      <button type="button" class="hero-btn" data-hero-seed>Randomise</button>
      <button type="button" class="hero-btn" data-hero-play aria-pressed="true">Pause</button>
    </div>
    <hr class="laser" />
  </div>
</section>

<style>
  .hero-floor {
    opacity: 0.18;
    background-image:
      repeating-linear-gradient(to right, rgba(57, 255, 20, 0.5) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(to bottom, rgba(57, 255, 20, 0.5) 0 1px, transparent 1px 72px);
    animation: floor-drive 9s linear infinite;
  }

  @keyframes floor-drive {
    to {
      background-position:
        0 0,
        0 72px;
    }
  }

  /* Scrim is doing the legibility work now that copy sits over the middle of
     the canvas rather than above it. */
  .hero-scrim {
    background:
      radial-gradient(ellipse 52% 40% at 50% 46%, rgba(3, 10, 5, 0.88), rgba(3, 10, 5, 0.4) 68%, transparent 88%),
      linear-gradient(to bottom, var(--color-ground) 3%, transparent 22%, transparent 78%, rgba(3, 10, 5, 0.8));
  }

  .hero-scan {
    opacity: 0.35;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.26) 0 1px,
      transparent 1px 3px
    );
  }

  .hero-btn {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    border: 1px solid var(--color-edge);
    color: var(--color-muted);
    background: color-mix(in oklab, var(--color-ground) 55%, transparent);
    transition:
      color 0.18s,
      border-color 0.18s,
      background-color 0.18s,
      box-shadow 0.18s;
  }

  .hero-btn:hover {
    color: var(--color-text);
    border-color: var(--color-edge-bright);
  }

  .hero-btn[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 0 16px -4px rgba(57, 255, 20, 0.7);
  }
</style>

<script>
  /* Four modes on one canvas. Bloom comes from 'lighter' compositing — a
     shadowBlur per stroke is what kills the framerate at this particle count. */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: false });

    if (ctx) {
      type Particle = { x: number; y: number; px: number; py: number; life: number };
      type Star = { x: number; y: number; z: number; pz: number };

      const modeBtns = document.querySelectorAll<HTMLButtonElement>('[data-hero-mode]');
      const playBtn = document.querySelector<HTMLButtonElement>('[data-hero-play]');

      let width = 0;
      let height = 0;
      let mode = 0;
      let t = 0;
      let raf = 0;
      let running = false;
      let particles: Particle[] = [];
      let stars: Star[] = [];
      let seedA = Math.random() * 100;
      let seedB = Math.random() * 100;

      const spawn = (): Particle => ({
        x: Math.random() * width,
        y: Math.random() * height,
        px: 0,
        py: 0,
        life: 20 + Math.random() * 150,
      });

      function clear() {
        ctx!.globalCompositeOperation = 'source-over';
        ctx!.fillStyle = '#030a05';
        ctx!.fillRect(0, 0, width, height);
      }

      function build() {
        /* This is a diffuse field behind a scrim, so it does not need device
           pixels. Every frame washes the whole canvas, making that fill the
           dominant cost: at DPR 2 a phone was painting ~1.2M px per frame and
           holding 28fps. Rendering at 1x is imperceptible here and quarters it. */
        const dpr = Math.min(window.devicePixelRatio || 1, window.innerWidth < 900 ? 1 : 1.5);
        const rect = canvas!.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas!.width = Math.round(width * dpr);
        canvas!.height = Math.round(height * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        clear();

        // Scale with area, hard ceiling for low-end GPUs. Denser than a normal
        // background because the scrim eats most of it.
        const count = Math.min(560, Math.max(90, Math.round((width * height) / 1800)));
        particles = Array.from({ length: count }, spawn);
        stars = Array.from({ length: Math.round(count * 0.7) }, () => ({
          x: (Math.random() - 0.5) * width,
          y: (Math.random() - 0.5) * height,
          z: Math.random() * width,
          pz: 0,
        }));
      }

      function angleAt(x: number, y: number) {
        const a = Math.sin(x * 0.0042 + seedA + t * 0.22) + Math.cos(y * 0.0051 - seedB + t * 0.17);
        const b = Math.sin((x + y) * 0.0027 + t * 0.11) * 1.4;
        return (a + b) * 1.15;
      }

      function wash(alpha: number) {
        ctx!.globalCompositeOperation = 'source-over';
        ctx!.fillStyle = `rgba(3, 10, 5, ${alpha})`;
        ctx!.fillRect(0, 0, width, height);
      }

      function step() {
        t += 0.0075;

        if (mode === 0) {
          // Lighter wash than usual so trails survive long enough to read as
          // lines rather than dots.
          wash(0.05);
          ctx!.globalCompositeOperation = 'lighter';
          ctx!.lineWidth = 1.1;
          for (let i = 0; i < particles.length; i++) {
            const p = particles[i];
            p.px = p.x;
            p.py = p.y;
            const a = angleAt(p.x, p.y);
            p.x += Math.cos(a) * 1.7;
            p.y += Math.sin(a) * 1.7;
            p.life -= 0.4;
            const hue = 104 + ((((a % 1) + 1) % 1) * 58);
            ctx!.strokeStyle = `hsla(${hue}, 100%, 58%, 0.5)`;
            ctx!.beginPath();
            ctx!.moveTo(p.px, p.py);
            ctx!.lineTo(p.x, p.y);
            ctx!.stroke();
            if (p.life < 0 || p.x < -20 || p.x > width + 20 || p.y < -20 || p.y > height + 20) {
              particles[i] = spawn();
            }
          }
        } else if (mode === 1) {
          wash(0.2);
          ctx!.globalCompositeOperation = 'lighter';
          const cx = width / 2;
          const cy = height / 2;
          for (const s of stars) {
            s.pz = s.z;
            s.z -= 3;
            if (s.z < 1) {
              s.x = (Math.random() - 0.5) * width * 1.4;
              s.y = (Math.random() - 0.5) * height * 1.4;
              s.z = width;
              s.pz = width;
            }
            const sx = cx + (s.x / s.z) * width * 0.9;
            const sy = cy + (s.y / s.z) * width * 0.9;
            const ex = cx + (s.x / s.pz) * width * 0.9;
            const ey = cy + (s.y / s.pz) * width * 0.9;
            const d = 1 - s.z / width;
            ctx!.lineWidth = 0.4 + d * 2.2;
            ctx!.strokeStyle = `hsla(${108 + d * 46}, 100%, ${48 + d * 30}%, ${0.22 + d * 0.68})`;
            ctx!.beginPath();
            ctx!.moveTo(ex, ey);
            ctx!.lineTo(sx, sy);
            ctx!.stroke();
          }
        } else if (mode === 2) {
          wash(0.1);
          ctx!.globalCompositeOperation = 'lighter';
          const A = 3 + Math.sin(t * 0.13) * 2;
          const B = 2 + Math.cos(t * 0.09) * 2;
          const ph = t * 0.4;
          const rx = width * 0.3;
          const ry = height * 0.32;
          const cx = width / 2;
          const cy = height / 2;
          // Wide-and-dim, medium, then a thin near-white core.
          const widths = [3.2, 1.6, 0.8];
          const cols = ['rgba(57,255,20,.14)', 'rgba(0,255,157,.34)', 'rgba(234,255,232,.7)'];
          for (let layer = 0; layer < 3; layer++) {
            ctx!.lineWidth = widths[layer];
            ctx!.strokeStyle = cols[layer];
            ctx!.beginPath();
            for (let u = 0; u <= 360; u++) {
              const th = (u / 360) * Math.PI * 2;
              const X = cx + Math.sin(A * th + ph) * rx;
              const Y = cy + Math.sin(B * th) * ry;
              if (u) ctx!.lineTo(X, Y);
              else ctx!.moveTo(X, Y);
            }
            ctx!.stroke();
          }
        } else {
          wash(0.3);
          ctx!.globalCompositeOperation = 'lighter';
          const N = width < 640 ? 36 : 64;
          const gap = 2;
          const bw = (width - gap * (N - 1)) / N;
          const base = height * 0.82;
          for (let i = 0; i < N; i++) {
            const f = i / N;
            let v =
              Math.abs(Math.sin(t * 1.9 + f * 7.1)) * 0.5 +
              Math.abs(Math.sin(t * 0.7 + f * 13.3)) * 0.32 +
              Math.abs(Math.sin(t * 3.3 - f * 4.2)) * 0.18;
            v *= (1 - f * 0.55) * (0.55 + 0.45 * Math.sin(f * Math.PI));
            const h = Math.max(2, v * height * 0.5);
            const x = i * (bw + gap);
            const hue = 100 + f * 60;
            ctx!.fillStyle = `hsla(${hue}, 100%, 55%, 0.75)`;
            ctx!.fillRect(x, base - h, bw, h);
            ctx!.fillStyle = `hsla(${hue}, 100%, 55%, 0.14)`;
            ctx!.fillRect(x, base + 3, bw, h * 0.42);
          }
        }
      }

      function frame() {
        if (!running) return;
        step();
        raf = requestAnimationFrame(frame);
      }

      let onScreen = true;
      let tabVisible = !document.hidden;
      let wanted = !reduced;

      function sync() {
        if (wanted && onScreen && tabVisible) {
          if (running) return;
          running = true;
          raf = requestAnimationFrame(frame);
        } else if (running) {
          running = false;
          cancelAnimationFrame(raf);
        }
      }

      const settle = () => {
        for (let i = 0; i < 320; i++) step();
      };

      build();
      canvas.classList.replace('opacity-0', 'opacity-60');

      if (reduced) settle();

      for (const btn of modeBtns) {
        btn.addEventListener('click', () => {
          mode = Number(btn.dataset.heroMode);
          for (const o of modeBtns) o.setAttribute('aria-pressed', String(o === btn));
          clear();
          if (reduced) settle();
        });
      }

      document.querySelector('[data-hero-seed]')?.addEventListener('click', () => {
        seedA = Math.random() * 100;
        seedB = Math.random() * 100;
        t = Math.random() * 50;
        build();
        if (reduced) settle();
      });

      playBtn?.addEventListener('click', () => {
        wanted = !wanted;
        playBtn.textContent = wanted ? 'Pause' : 'Play';
        playBtn.setAttribute('aria-pressed', String(wanted));
        sync();
      });

      sync();

      // Run only when the hero is BOTH on-screen and in a visible tab. Tracked
      // separately: with one flag, returning to the tab would restart the loop
      // even if the user had long since scrolled past.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          ([entry]) => {
            onScreen = entry.isIntersecting;
            sync();
          },
          { threshold: 0 }
        ).observe(canvas);
      }

      document.addEventListener('visibilitychange', () => {
        tabVisible = !document.hidden;
        sync();
      });

      let resizeTimer: number;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          build();
          if (reduced) settle();
        }, 180);
      });
    }
  }
</script>
